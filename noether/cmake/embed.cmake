# Generates a C++ source holding text files as raw string literals.
#   cmake -DOUT=<file.cpp> -DFUNC=<function name> -DROOT=<dir> -DFILES=<a,b,c> -P embed.cmake
# Each entry is {path relative to ROOT, contents}; the function returns them as a span.
string(REPLACE "," ";" FILES "${FILES}")
set(body "")
foreach(rel IN LISTS FILES)
    file(READ "${ROOT}/${rel}" text)
    string(FIND "${text}" ")NTRX\"" bad)
    if(NOT bad EQUAL -1)
        message(FATAL_ERROR "${rel} contains the raw-string delimiter )NTRX\"")
    endif()
    string(APPEND body "        {\"${rel}\", R\"NTRX(${text})NTRX\"},\n")
endforeach()
set(content "// Generated by embed.cmake; do not edit.\n#include \"Embedded.hpp\"\n\nnamespace Noether\n{\n\nstd::span<const EmbeddedFile> ${FUNC}()\n{\n    static const EmbeddedFile files[] = {\n${body}    };\n    return files;\n}\n\n} // namespace Noether\n")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
    if(old STREQUAL content)
        return()
    endif()
endif()
file(WRITE "${OUT}" "${content}")
