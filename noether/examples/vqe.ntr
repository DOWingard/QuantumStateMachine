noether 0.1
## Variational quantum eigensolver (VQE) for the 4-site transverse-field Ising chain at g = 1:
##
##     Ham = -Σ_{j=0}^{2} Z_j Z_{j+1} - g Σ_{j=0}^{3} X_j,   exact ground energy E₀ = -4.7587705
##
## (E₀ from exact diagonalisation of the 16×16 matrix; the spectrum is symmetric, E_max = -E₀.)
## The ansatz is a real-amplitude circuit, since Ham is real: layers + 1 rows of Ry(θ) rotations
## with a CNOT ladder between rows, 12 params in all. Its energy is printed as `energy`.
##
## Expected: at the default θ = 0 the state is |0000⟩ and energy = -(N-1) = -3. For every θ the
## variational principle gives E₀ ≤ ⟨Ham⟩ ≤ E_max, which is what the asserts check, so they also
## hold for optimised params.
##
## Optimise it with
##     noether opt vqe.ntr --minimize energy                 → -4.730219 (gap to E₀: 2.9e-2)
##     noether opt vqe.ntr --minimize energy --method adam   → -4.755843 (gap to E₀: 2.9e-3)
##     noether opt vqe.ntr --minimize energy --restarts 4    → -4.748041 (gap to E₀: 1.1e-2)
## Each command writes the best θ to params.json. Evaluate a point with
##     noether run vqe.ntr --set 'θ=[0.17, -0.16, …]'
## and inspect the gradient with `noether grad vqe.ntr --of energy`.
let N = 4, g = 1, layers = 2, groundEnergy = -4.758770483143634
qubits q[N]; seed 1
let Ham = -Σ_{j=0}^{N - 2} Z_j Z_{j + 1} - g Σ_{j=0}^{N - 1} X_j
param θ[N (layers + 1)] ∈ [-π, π] = 0
prepare |0⟩^⊗N
for l ∈ 0..layers:
    for j ∈ 0..N - 1:
        Ry(θ[l N + j])_j
    if l < layers:
        for j ∈ 0..N - 2:
            CNOT_{j→j + 1}
print ⟨Ham⟩ as energy
assert ⟨Ham⟩ ≥ groundEnergy - 1e-9
assert ⟨Ham⟩ ≤ -groundEnergy + 1e-9
