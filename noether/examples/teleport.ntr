noether 0.1
## Quantum teleportation with classical feed-forward.
##
## Alice holds |ψ⟩ = Rz(φ) Ry(θ) |0⟩ on q[0] and shares the Bell pair (|00⟩ + |11⟩)/√2 on
## q[1], q[2] with Bob. She measures q[0], q[1] in the Bell basis; Bob applies X^{m1} then
## Z^{m0} to q[2] and ends up holding |ψ⟩ whatever the outcomes were.
##
## Expected: Bob's Bloch vector is (⟨X⟩, ⟨Y⟩, ⟨Z⟩) = (sin θ cos φ, sin θ sin φ, cos θ)
## = (0.70063, 0.50904, 0.5) for θ = π/3, φ = π/5, exactly. Undoing the preparation on q[2]
## must then give out = 0 on every shot, while the four Bell outcomes m are uniform:
## P(m) = 1/4, so over 4000 shots each count is 1000 ± 27 (1σ); the asserts allow ±100.
let θ = π/3, φ = π/5
qubits q[3]; bits m[2], out[1]; seed 7
prepare |000⟩
Rz(φ)_0 Ry(θ)_0
CNOT_{1→2} H_1
H_0 CNOT_{0→1}
m[0] ← measure Z_0
m[1] ← measure Z_1
if m[1]: X_2
if m[0]: Z_2
print ⟨X_2⟩ as bobX, ⟨Y_2⟩ as bobY, ⟨Z_2⟩ as bobZ
assert ⟨X_2⟩ ≈ sin(θ) cos(φ) ± 1e-9
assert ⟨Y_2⟩ ≈ sin(θ) sin(φ) ± 1e-9
assert ⟨Z_2⟩ ≈ cos(θ) ± 1e-9
Ry(-θ)_2 Rz(-φ)_2
out[0] ← measure Z_2
counts ← run 4000
print marginal(counts, m) as bell, marginal(counts, out) as undone
assert marginal(counts, out)["0"] == 4000
assert marginal(counts, m)["00"] ≈ 1000 ± 100
assert marginal(counts, m)["01"] ≈ 1000 ± 100
assert marginal(counts, m)["10"] ≈ 1000 ± 100
assert marginal(counts, m)["11"] ≈ 1000 ± 100
