noether 0.1
## CHSH inequality and the CHSH game with a Bell pair.
##
## Alice measures A₀ = Z or A₁ = X; Bob measures B₀ = (Z + X)/√2 or B₁ = (Z − X)/√2. On
## |Φ⁺⟩ = (|00⟩ + |11⟩)/√2, ⟨A_x B_y⟩ = ±1/√2, so
##     S = ⟨A₀B₀⟩ + ⟨A₀B₁⟩ + ⟨A₁B₀⟩ − ⟨A₁B₁⟩ = 2√2 ≈ 2.828 (Tsirelson's bound),
## beyond the local-hidden-variable bound S ≤ 2.
##
## The game: two quantum coins choose x, y; the players win when a ⊕ b = x ∧ y. Any classical
## strategy wins at most 3/4; the quantum one wins with cos²(π/8) = (2 + √2)/4 = 0.85355.
## Bob measures B_y by rotating with Ry(∓π/4); one Pauli measurement Z₀Z₁ then records a ⊕ b.
## Over 20 000 rounds: wins = 17071 ± 50 (1σ), assert ±160. Each setting gets ≈ 5000 rounds and
## Var(ab) = 1 − 1/2 per round, so the sampled S has σ ≈ √(4 · 0.5/5000) = 0.020, assert ±0.07.
qubits q[2], coin[2]; bits xy[2], parity[1]; seed 99
let A0 = Z_0, A1 = X_0, B0 = (Z_1 + X_1)/√(2), B1 = (Z_1 - X_1)/√(2)
prepare |0000⟩
H_0; CNOT_{0→1}
print ⟨A0 B0 + A0 B1 + A1 B0 - A1 B1⟩ as exactS
assert ⟨A0 B0 + A0 B1 + A1 B0 - A1 B1⟩ ≈ 2 √(2) ± 1e-12
assert ⟨A1 B1⟩ ≈ -1/√(2) ± 1e-12
H_coin
xy ← measure_coin
if xy[0]: H_0
if xy[1]: Ry(π/4)_1
else: Ry(-π/4)_1
parity[0] ← measure Z_0 Z_1
counts ← run 20000
let wins = counts["00|0"] + counts["01|0"] + counts["10|0"] + counts["11|1"]
let e00 = (counts["00|0"] - counts["00|1"])/(counts["00|0"] + counts["00|1"])
let e01 = (counts["01|0"] - counts["01|1"])/(counts["01|0"] + counts["01|1"])
let e10 = (counts["10|0"] - counts["10|1"])/(counts["10|0"] + counts["10|1"])
let e11 = (counts["11|0"] - counts["11|1"])/(counts["11|0"] + counts["11|1"])
print wins/20000 as winRate, e00 + e01 + e10 - e11 as sampledS
assert wins ≈ 20000 (2 + √(2))/4 ± 160
assert e00 + e01 + e10 - e11 ≈ 2 √(2) ± 0.07
assert e00 + e01 + e10 - e11 > 2
