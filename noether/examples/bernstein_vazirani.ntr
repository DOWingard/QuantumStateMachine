noether 0.1
## Bernstein–Vazirani: recover a hidden 40-bit string s from ONE query to f(x) = s·x mod 2.
##
## The oracle is a CNOT from every x_j with s_j = 1 onto a target held in |−⟩, which kicks back
## the phase (−1)^{s·x}. Hadamards before and after map |0…0⟩ → 2^{-n/2} Σ_x (−1)^{s·x}|x⟩ → |s⟩,
## so the measurement returns s with certainty:
##     P(x = s) = |2^{-n} Σ_x (−1)^{s·x + s·x}|² = 1.
## A classical algorithm needs n = 40 queries (one per bit). Every gate is Clifford, so this runs
## on the stabilizer backend; the 41-qubit state vector would need 32 TiB.
##
## Expected: ⟨Z_j⟩ = (−1)^{s_j} on every input qubit, ⟨X⟩ = −1 on the target, and all 1000 shots
## read s = 1011001110001111000010101101001100111010.
let n = 40
qubits x[n], y[1]; bits c[n]; seed 8
prepare |0⟩^⊗n ⊗ |-⟩
H_x
for j ∈ [0, 2, 3, 6, 7, 8, 12, 13, 14, 15, 20, 22, 24, 25, 27, 30, 31, 34, 35, 36, 38]:
    CNOT_{x[j]→y[0]}
H_x
print ⟨Z_{x[0]}⟩ as z0, ⟨Z_{x[1]}⟩ as z1, ⟨X_{y[0]}⟩ as targetX
assert ⟨Z_{x[0]}⟩ ≈ -1 ± 1e-12
assert ⟨Z_{x[1]}⟩ ≈ 1 ± 1e-12
assert ⟨Z_{x[38]}⟩ ≈ -1 ± 1e-12
assert ⟨Z_{x[39]}⟩ ≈ 1 ± 1e-12
assert ⟨X_{y[0]}⟩ ≈ -1 ± 1e-12
c ← measure_x
counts ← run 1000
print counts
assert counts["1011001110001111000010101101001100111010"] == 1000
